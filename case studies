7. Python source code

distance = float(input("Enter journey distance: "))
reserve = float(input("Enter reserve fuel: "))

vehicles = [
    ["Car", 15, 5],
    ["Bike", 40, 3],
    ["Bus", 10, 8]
]

min_cost = 999999
best_vehicle = ""

for v in vehicles:
    name = v[0]
    mileage = v[1]
    fuel_price = v[2]

    fuel = distance / mileage

    if fuel >= reserve:
        cost = fuel * fuel_price

        print(name, "Cost:", cost)

        if cost < min_cost:
            min_cost = cost
            best_vehicle = name

if best_vehicle != "":
    print("Best Vehicle:", best_vehicle)
    print("Minimum Cost:", min_cost)
else:
    print("No feasible vehicle found")

