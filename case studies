units = int(input("Enter electricity units: "))

if units <= 100:
    bill = units * 2
elif units <= 200:
    bill = 100 * 2 + (units - 100) * 3
else:
    bill = 100 * 2 + 100 * 3 + (units - 200) * 5

fixed_charge = 50
rebate = 20

total = bill + fixed_charge - rebate

print("Energy Charge:", bill)
print("Fixed Charge:", fixed_charge)
print("Rebate:", rebate)
print("Final Electricity Bill:", total)

